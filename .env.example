# =============================================================================
# llama-hub — configuración (copia a `.env`; git lo ignora)
#
# Funciona tal cual: TODAS las variables tienen valor por defecto en lib/common.sh.
# Descomenta y ajusta solo las que necesites. Referencia completa: README.md.
# =============================================================================

# --- Backend / hardware ------------------------------------------------------
# auto | cpu | nvidia | amd-vulkan | amd-rocm
# Con `auto`: si hay NVIDIA -> nvidia; si hay /dev/dri -> amd-vulkan; si no -> cpu.
# `amd-rocm` (ROCm nativo) hay que forzarlo explícitamente.
BACKEND=auto

# Sufijo opcional del tag de imagen, p. ej. `-b4667` para fijar un build.
# Vacío = última imagen estable (tags `server`, `server-cuda`, `server-vulkan`...).
# LLAMA_SUFFIX=

# GPU NVIDIA: dispositivos visibles dentro del contenedor.
# NVIDIA_VISIBLE_DEVICES=all
# GPU AMD/Intel: nodo DRM del host que se mapea a /dev/dri dentro del contenedor.
# AMD_RENDER_NODE=/dev/dri
# GID de los grupos `video`/`render` del host añadidos al contenedor (AMD Vulkan/ROCm).
# Se detectan solos desde el host; define solo si quieres forzar un valor.
# VIDEO_GID=
# RENDER_GID=

# --- Servidor ----------------------------------------------------------------
# Dirección de escucha dentro del contenedor (no cambiar salvo caso especial).
# LLAMA_HOST=0.0.0.0
# Puerto publicado en el host (el contenedor siempre escucha en 8080).
# PORT=8080
# API key opcional para proteger el endpoint (vacío = sin autenticación).
# API_KEY=
# Límites de recursos del contenedor (0 = sin límite).
# MEM_LIMIT=0
# CPUS=0
# Política de reinicio: no | unless-stopped | always | on-failure
# RESTART_POLICY=no
# Espera antes de contar fallos del healthcheck. Evita el falso "unhealthy"
# mientras el modelo carga (/health responde 503). Súbelo si tus modelos tardan.
# Formato Docker: 300s, 5m, 1h30m...
# HEALTH_START_PERIOD=300s

# --- Modelos / descarga ------------------------------------------------------
# Carpeta local donde se guardan los .gguf (relativa al repo, absoluta o con ~).
# MODELS_DIR=./models
# Caché JIT de CUDA (persistente entre recreaciones del contenedor). Evita que la
# primera inferencia recompile kernels (~decenas de segundos) tras `docker rm`.
# CUDA_CACHE_DIR=./.cache/nv
# Token de HuggingFace; solo necesario para repos gated o privados.
# HF_TOKEN=

# --- Memoria / offload -------------------------------------------------------
# Tablas PLE (Gemma 4 E2B/E4B) a RAM en vez de VRAM.
# PLE_TO_RAM=true
# Proyector multimodal (mmproj) a RAM en vez de VRAM.
# MMPROJ_TO_RAM=true
# Capas a VRAM: N | auto | all
# N_GPU_LAYERS=all

# --- Speculative decoding ----------------------------------------------------
# Drafting por n-gramas (ngram-mod) para modelos SIN draft propio. Ligero
# (~16MB) y seguro: el target verifica cada token, la salida no cambia.
# Los modelos con drafter MTP (Gemma4 QAT) usan draft-mtp en su lugar.
# SPEC_NGRAM=true

# --- Contexto / KV cache -----------------------------------------------------
# Contexto preferido. 0 = usar el nativo del modelo.
# El máximo del modelo se autodetecta (metadatos GGUF); el efectivo es min(CTX_SIZE, máximo).
# CTX_SIZE=32768
# Tipo de dato del KV cache (q8_0). q8_0 ahorra ~mitad de VRAM del KV frente a f16.
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0
# Flash Attention: on | off | auto. Requerido para KV cache cuantizado.
# FLASH_ATTN=on
# Lectura perezosa de tensores grandes desde disco: on | auto | off.
# off = mantener residentes en memoria. Recomendado con RAM abundante; obligatorio con HDD.
# Nota: con PLE_TO_RAM=true se fuerza a "off" en los modelos PLE (Gemma 4 E2B/E4B).
# LAZY_MODE=off
# Modo de carga del modelo: auto | none | mmap | mlock | mmap+mlock | dio (vacío = auto).
# none = leer a RAM sin mmap. Con PLE_TO_RAM=true se usa "none" automáticamente para
# evitar la penalización de los overrides a CPU con mmap. Rellénalo solo para forzarlo.
# LOAD_MODE=

# --- MoE (opt-in) ------------------------------------------------------------
# Por defecto los expertos se quedan en VRAM (mucho más rápido).
# Actívalos solo si no te cabe el modelo en VRAM (penaliza por tráfico PCIe).
# true = todos los expertos a CPU.
# CPU_MOE=false
# N > 0 = solo los expertos de las primeras N capas a CPU.
# N_CPU_MOE=0
# Cache en GPU (MiB) para expertos "calientes" cuando se usa offload a CPU.
# MOE_CACHE_MIB=0
